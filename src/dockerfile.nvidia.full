ARG NVIDIA_CORE_IMAGE=nvidia-core
FROM ${NVIDIA_CORE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/offloadr/base"

ENV OFFLOADR_WHEELHOUSE=/opt/offloadr-wheelhouse

# Keep optional accelerator wheels as an explicit offline install source
COPY --from=sageattention /workspace/SageAttention/dist/ /opt/offloadr-wheelhouse/
COPY --from=nunchaku /artifacts/nunchaku/dist/ /opt/offloadr-wheelhouse/
COPY --from=xformers /artifacts/xformers/dist/ /opt/offloadr-wheelhouse/
COPY --from=flashattention /artifacts/flashattention/dist/ /opt/offloadr-wheelhouse/
