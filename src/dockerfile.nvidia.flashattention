FROM builder

LABEL org.opencontainers.image.source="https://github.com/offloadr/base"

ARG FLASH_ATTENTION_VERSION=3.0.1

# Download the prebuilt FlashAttention 3 wheel for the CUDA 13 family
# These stable-ABI CUDA 13 wheels are published in the cu130 index.
ARG WHEEL_TORCH_FLAVOR=cu130

RUN --mount=type=cache,target=/cache/uv,sharing=locked \
    mkdir -p /artifacts/flashattention/dist && \
    export CUDA_TAG=${WHEEL_TORCH_FLAVOR} && \
    export FLASH_ATTENTION_WHEEL=flash_attn_3-${FLASH_ATTENTION_VERSION}-cp310-abi3-manylinux_2_28_x86_64.whl && \
    python - <<'PY'
import os
import pathlib
import urllib.request

cuda_tag = os.environ["CUDA_TAG"]
wheel = os.environ["FLASH_ATTENTION_WHEEL"]
dist = pathlib.Path("/artifacts/flashattention/dist")
url = f"https://download.pytorch.org/whl/{cuda_tag}/{wheel}"
print(url)
urllib.request.urlretrieve(url, dist / wheel)
PY
