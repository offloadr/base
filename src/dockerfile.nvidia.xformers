FROM builder

LABEL org.opencontainers.image.source="https://github.com/offloadr/base"

ARG XFORMERS_VERSION=0.0.35

# These stable-ABI CUDA 13 wheels are published in the cu130 index.
ARG WHEEL_TORCH_FLAVOR=cu130

RUN --mount=type=cache,target=/cache/uv,sharing=locked \
    mkdir -p /artifacts/xformers/dist && \
    export CUDA_TAG=${WHEEL_TORCH_FLAVOR} && \
    export XFORMERS_WHEEL=xformers-${XFORMERS_VERSION}-py39-none-manylinux_2_28_x86_64.whl && \
    python - <<'PY'
import os
import pathlib
import urllib.request

cuda_tag = os.environ["CUDA_TAG"]
wheel = os.environ["XFORMERS_WHEEL"]
dist = pathlib.Path("/artifacts/xformers/dist")
url = f"https://download.pytorch.org/whl/{cuda_tag}/{wheel}"
print(url)
urllib.request.urlretrieve(url, dist / wheel)
PY
